# ==============================================================================
# TempShield - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env in your root directory:
#   cp .env.example .env
#
# IMPORTANT:
# - All keys defined here are loaded securely on the server (server.ts).
# - Never commit your real .env file with production credentials to GitHub!
# ==============================================================================

# 1. JWT Authentication Secret
# Used to sign and verify JSON Web Tokens for user sessions.
# Generate a cryptographically random 64-character hex string:
JWT_SECRET=8f4c2e91a7d63b05e9c18f72d4a6b3e8c91f05a27d6e4b8f3c2a9e7d1b6f4c8

# 2. Twilio SMS Gateway (Primary Provider for Real OTP Delivery)
# Obtain these from your Twilio Console: https://console.twilio.com/
# - TWILIO_ACCOUNT_SID: Found on the Twilio Console dashboard (e.g., ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
# - TWILIO_AUTH_TOKEN: Found on the Twilio Console dashboard (e.g., your secret auth token)
# - TWILIO_PHONE_NUMBER: An active Twilio E.164 phone number enabled for SMS (e.g., +12345678901)
TWILIO_ACCOUNT_SID=REPLACE_WITH_YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_YOUR_TWILIO_PHONE_NUMBER

# 3. Optional Virtual SMS Number Providers (For rented numbers catalog)
# Only required if using external 3P numbers APIs:
SMS_ACTIVATE_API_KEY=REPLACE_WITH_YOUR_SMS_ACTIVATE_API_KEY
FIVESIM_API_KEY=REPLACE_WITH_YOUR_FIVESIM_API_KEY

# 4. Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
